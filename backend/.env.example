# AI provider: gemini is recommended for a free vision-capable API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Optional fallback/provider alternative.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_PRESCRIPTION_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_OTC_MODEL=claude-haiku-4-5-20251001

# Email delivery for reservation confirmations and status updates.
# Option 1: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=verified_sender@yourdomain.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=your_email@gmail.com
